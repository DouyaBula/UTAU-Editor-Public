<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>UTAU Editor: an unofficial osu!lazer editor with additional mapping tools.</Description>
    <AssemblyName>osu!</AssemblyName>
    <AssemblyTitle>UTAU Editor</AssemblyTitle>
    <Title>UTAU Editor</Title>
    <Product>UTAU Editor</Product>
    <ApplicationIcon>lazer.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <!-- Upstream interprets the assembly major/minor as a dated official API version. -->
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <!-- Required for deployment. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <StartupHookSupport>false</StartupHookSupport>
    <CETCompat>false</CETCompat>
  </PropertyGroup>

  <PropertyGroup>
    <StartupObject>osu.Desktop.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup Label="Project References">
    <ProjectReference Include="..\osu.Game.Tournament\osu.Game.Tournament.csproj"/>
    <ProjectReference Include="..\osu.Game\osu.Game.csproj"/>
    <ProjectReference Include="..\osu.Game.Rulesets.Osu\osu.Game.Rulesets.Osu.csproj"/>
    <ProjectReference Include="..\osu.Game.Rulesets.Catch\osu.Game.Rulesets.Catch.csproj"/>
    <ProjectReference Include="..\osu.Game.Rulesets.Mania\osu.Game.Rulesets.Mania.csproj"/>
    <ProjectReference Include="..\osu.Game.Rulesets.Taiko\osu.Game.Rulesets.Taiko.csproj"/>
  </ItemGroup>
  <ItemGroup Label="Package References">
    <PackageReference Include="System.IO.Packaging" Version="10.0.12"/>
    <!-- Held back due to invite bug in newer versions. See https://github.com/Lachee/discord-rpc-csharp/issues/286 -->
    <PackageReference Include="DiscordRichPresence" Version="1.5.0.51"/>
    <PackageReference Include="Velopack" Version="1.2.0"/>
  </ItemGroup>
  <ItemGroup Label="Resources">
    <EmbeddedResource Include="lazer.ico"/>
  </ItemGroup>
  <ItemGroup Label="Windows Icons">
    <Content Include="*.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>
  <ItemGroup Label="Portable Distribution">
    <Content Include="utau-editor.portable" CopyToPublishDirectory="Always" />
    <Content Include="..\LICENCE" Link="LICENCE" CopyToPublishDirectory="Always" />
    <Content Include="..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToPublishDirectory="Always" />
    <Content Include="..\docs\portable.md" Link="PORTABLE.md" CopyToPublishDirectory="Always" />
    <Content Include="..\osu.Game.Rulesets.Osu\Edit\Resources\Fonts\NotoSansMath-OFL.txt" Link="licences\NotoSansMath-OFL.txt" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
